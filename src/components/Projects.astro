---

<section id="work" style="padding-top: 5rem; padding-bottom: 6rem;">
  <div class="container-custom">
    
    <!-- Section Title & Category Filter Tabs -->
    <div style="display: flex; flex-direction: column; gap: 1.5rem; margin-bottom: 3rem;">
      <div style="display: flex; align-items: flex-end; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
        <div>
          <div class="font-mono" style="font-size: 0.75rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.5rem;">
            // <span data-lang-content="en">FEATURED REPERTOIRE</span><span data-lang-content="zh">精选代表作品</span>
          </div>
          <h2 style="font-size: 2rem; font-weight: 700; letter-spacing: -0.025em; color: var(--text-primary);">
            <span data-lang-content="en">Crafted with Purpose & Precision</span>
            <span data-lang-content="zh">以工程确定性铸就每一项交付</span>
          </h2>
        </div>

        <!-- Filter Tabs -->
        <div class="filter-container" style="display: flex; align-items: center; gap: 0.5rem; flex-wrap: wrap;">
          <button class="filter-tab active" data-filter="all">
            <span data-lang-content="en">All</span>
            <span data-lang-content="zh">全部</span>
          </button>
          <button class="filter-tab" data-filter="spatial">
            <span data-lang-content="en">Spatial & 3D</span>
            <span data-lang-content="zh">空间与3D</span>
          </button>
          <button class="filter-tab" data-filter="agents">
            <span data-lang-content="en">Autonomous Agents</span>
            <span data-lang-content="zh">智能体架构</span>
          </button>
          <button class="filter-tab" data-filter="engineering">
            <span data-lang-content="en">Engineering Systems</span>
            <span data-lang-content="zh">工业与系统</span>
          </button>
        </div>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" style="display: grid; grid-template-columns: repeat(auto-fill, minmax(360px, 1fr)); gap: 1.75rem;">
      {projects.map((proj) => (
        <article class="interactive-card project-card" data-category={proj.category} style="display: flex; flex-direction: column;">
          
          <!-- Cover Image Container -->
          <div style="position: relative; width: 100%; aspect-ratio: 16/9; overflow: hidden; background-color: #111111; border-bottom: 1px solid var(--border-color);">
            <img 
              src={proj.cover} 
              alt={proj.titleEn}
              loading="lazy"
              style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);"
              class="project-img"
            />
            <!-- Category Badge overlay -->
            <div style="position: absolute; top: 12px; left: 12px;">
              <span class="font-mono" style="font-size: 0.65rem; padding: 0.25rem 0.5rem; border-radius: 4px; background-color: rgba(0, 0, 0, 0.75); color: #ffffff; backdrop-filter: blur(8px); border: 1px solid rgba(255, 255, 255, 0.15); letter-spacing: 0.04em;">
                <span data-lang-content="en">{proj.categoryLabelEn}</span>
                <span data-lang-content="zh">{proj.categoryLabelZh}</span>
              </span>
            </div>
          </div>

          <!-- Card Body -->
          <div style="padding: 1.5rem; display: flex; flex-direction: column; flex-grow: 1; justify-content: space-between;">
            <div>
              <h3 style="font-size: 1.25rem; font-weight: 600; line-height: 1.3; color: var(--text-primary); margin-bottom: 0.65rem; letter-spacing: -0.015em;">
                <span data-lang-content="en">{proj.titleEn}</span>
                <span data-lang-content="zh">{proj.titleZh}</span>
              </h3>
              <p style="font-size: 0.875rem; line-height: 1.6; color: var(--text-secondary); margin-bottom: 1.25rem;">
                <span data-lang-content="en">{proj.descEn}</span>
                <span data-lang-content="zh">{proj.descZh}</span>
              </p>
            </div>

            <!-- Footer: Tech Tags & Links -->
            <div>
              <!-- Tech Tags -->
              <div style="display: flex; flex-wrap: wrap; gap: 0.35rem; margin-bottom: 1.25rem;">
                {proj.tags.map((t) => (
                  <span class="tech-tag">{t}</span>
                ))}
              </div>

              <!-- Action Links -->
              <div style="display: flex; align-items: center; gap: 0.75rem; border-top: 1px solid var(--border-subtle); padding-top: 1rem; font-size: 0.8125rem;">
                {proj.demoUrl && (
                  <a href={proj.demoUrl} target="_blank" rel="noopener noreferrer" class="project-action-link" style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-primary); font-weight: 500; text-decoration: none;">
                    <span>Live Demo</span>
                    <svg style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                )}
                {proj.repoUrl && (
                  <a href={proj.repoUrl} target="_blank" rel="noopener noreferrer" class="project-action-link" style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-secondary); text-decoration: none;">
                    <span>GitHub</span>
                    <svg style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                )}
                {proj.bilibiliUrl && (
                  <a href={proj.bilibiliUrl} target="_blank" rel="noopener noreferrer" class="project-action-link" style="display: inline-flex; align-items: center; gap: 0.35rem; color: var(--text-secondary); text-decoration: none;">
                    <span>Bilibili 视频</span>
                    <svg style="width: 12px; height: 12px;" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                      <line x1="7" y1="17" x2="17" y2="7"></line>
                      <polyline points="7 7 17 7 17 17"></polyline>
                    </svg>
                  </a>
                )}
                {!proj.demoUrl && !proj.repoUrl && (
                  <span class="font-mono" style="font-size: 0.75rem; color: var(--text-muted);">
                    <span data-lang-content="en">Internal Production Framework</span>
                    <span data-lang-content="zh">内部核心架构与交付引擎</span>
                  </span>
                )}
              </div>
            </div>

          </div>

        </article>
      ))}
    </div>

  </div>
</section>

<style>
  .interactive-card:hover .project-img {
    transform: scale(1.03);
  }
  .project-action-link {
    transition: color 0.15s ease;
  }
  .project-action-link:hover {
    color: var(--text-primary) !important;
    text-decoration: underline;
  }
  @media (max-width: 640px) {
    #projects-grid {
      grid-template-columns: 1fr !important;
    }
  }
</style>

<script is:inline>
  function setupFilter() {
    const filterTabs = document.querySelectorAll('.filter-tab');
    const projectCards = document.querySelectorAll('.project-card');

    filterTabs.forEach((tab) => {
      tab.addEventListener('click', () => {
        // Toggle active class
        filterTabs.forEach(t => t.classList.remove('active'));
        tab.classList.add('active');

        const filterValue = tab.getAttribute('data-filter');

        projectCards.forEach((card) => {
          const cardCategory = card.getAttribute('data-category');
          if (filterValue === 'all' || cardCategory === filterValue) {
            card.style.display = 'flex';
          } else {
            card.style.display = 'none';
          }
        });
      });
    });
  }

  setupFilter();
  document.addEventListener('astro:page-load', setupFilter);
</script>
